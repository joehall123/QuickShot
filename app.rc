#pragma code_page(65001)
#include <windows.h>

// 应用程序清单（启用主题控件、声明 DPI 感知、标注支持 Win7+）
1 24 "app.manifest"

// 版本信息
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "QuickShot"
            VALUE "FileDescription",  "QuickShot 截图工具"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "QuickShot"
            VALUE "OriginalFilename", "QuickShot.exe"
            VALUE "ProductName",      "QuickShot"
            VALUE "ProductVersion",   "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
